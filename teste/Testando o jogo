#include <SDL2/SDL.h>
#include <SDL2/SDL_image.h>
#include <assert.h>

int main (int argc, char* args[])
{
    /* INICIALIZAÇÃO */
    SDL_Init(SDL_INIT_EVERYTHING);
    IMG_Init(0);
    SDL_Window* win = SDL_CreateWindow("Game v0.1",
                         SDL_WINDOWPOS_UNDEFINED,
                         SDL_WINDOWPOS_UNDEFINED,
                         0, 0,
                         SDL_WINDOW_FULLSCREEN_DESKTOP);
    SDL_Renderer* ren = SDL_CreateRenderer(win, -1, SDL_RENDERER_ACCELERATED);
    
    SDL_Texture* sprites = IMG_LoadTexture(ren, "sprites.png");
    SDL_Texture* fundo = IMG_LoadTexture(ren, "backgound.png");
    SDL_Texture* hud = IMG_LoadTexture(ren, "hud.png");
    SDL_Texture* lua = IMG_LoadTexture(ren, "lua.png");
    SDL_Texture* parafu = IMG_LoadTexture(ren, "parafu.png");
    SDL_Texture* parafr = IMG_LoadTexture(ren, "parafr.png");
    SDL_Texture* ponte = IMG_LoadTexture(ren, "ponte.png");
    
    assert(ponte && sprites && fundo && hud && lua && parafu && parafr);

	SDL_EventState(SDL_MOUSEMOTION, SDL_IGNORE);
	SDL_EventState(SDL_MOUSEBUTTONDOWN, SDL_IGNORE);
	SDL_EventState(SDL_MOUSEBUTTONUP, SDL_IGNORE);

    int largura, altura;
    SDL_GetWindowSize(win, &largura, &altura);

    /* EXECUÇÃO */
    
    SDL_Rect mapa = { 0, 0 , largura, altura };
    SDL_Rect moon = { 0, 0 , largura, altura };
    SDL_Rect parafun = { 0, 0 , largura, altura };
    SDL_Rect parafre = { 0, 0 , largura, altura };
    SDL_Rect vida = { 0, 0 , largura/4, altura/7 };
    SDL_Rect player = { largura/5, (altura - ((15*altura)/100)/3) - 95, 110, 100 };
    SDL_Rect ponteR = { 0, altura-((15*altura)/100), largura, (15*altura)/100};
    SDL_Rect chaoR = {0, (altura-((15*altura)/100)/3)+5, largura, ((15*altura)/100)/3};
	
	SDL_Rect f;

    int espera = 16;
    int vely = 0;
    int gravidade = 1;
    int puloInicial = -18;
    int noChao = 1;
    
    int direita = 1;
	int esquerda = -1;
	int frameAtual = direita;
	Uint32 ultimoFrameTroca = 0;
	int intervaloFrame = 120;
	int frameID = 0;
	int frameIE = 0;
	
	int virando = 0;
	int frameVirada = 0;

    int numPlataformas = 2;
    SDL_Rect plataformas[2] = {
        { 200, altura-200, 150,20 },
	{ 400, altura-300, 150,20 },
	
	};

while (!SDL_QuitRequested()) {

    // --- RENDERIZAÇÃO ---
    SDL_RenderCopy(ren, fundo ,NULL, &mapa);
    SDL_RenderCopy(ren, lua ,NULL, &moon);
    SDL_RenderCopy(ren, parafu ,NULL, &parafun);
    SDL_RenderCopy(ren, parafr ,NULL, &parafre);
	SDL_RenderCopy(ren, hud ,NULL, &vida);

    //SDL_SetRenderDrawColor(ren, 0x80,0x80,0x80,0x00);
    for (int i=0; i<numPlataformas; i++) {
        SDL_RenderFillRect(ren, &plataformas[i]);
    }


    SDL_RenderCopy(ren, sprites, &f, &player);
    SDL_RenderCopy(ren, ponte, NULL, &ponteR);

    SDL_RenderPresent(ren);


    // EVENTOS
    SDL_Event evt;
    int isevt = SDL_WaitEventTimeout(&evt, espera);
    if (isevt && evt.type == SDL_QUIT) {
        break;
    }

    // TECLADO
    const Uint8 *keys = SDL_GetKeyboardState(NULL);
    
    Uint32 agora = SDL_GetTicks();

    // Pulo (só se estiver no chão ou numa plataforma)
    if (keys[SDL_SCANCODE_Z] && noChao) {
        vely = puloInicial;
        noChao = 0;
    }
    
    int movendo = 0;

    // Movimento lateral
    if (keys[SDL_SCANCODE_LEFT]) {
        movendo = 1;
        if (frameAtual == direita && !virando) { virando = 1; frameVirada = 0; ultimoFrameTroca = agora; }
        	player.x -= 10;
            if (virando == 1) {
                if (agora - ultimoFrameTroca > intervaloFrame) {
                    ultimoFrameTroca = agora;
                    frameVirada++;
                    if (frameVirada > 2) { virando = 0; frameIE = 0; frameAtual = esquerda; }
                }
                f = (SDL_Rect){ 322 * frameVirada, 294, 322, 294 }; // linha 2
            } else {
                frameAtual = esquerda;
                if (agora - ultimoFrameTroca > intervaloFrame) {
                    ultimoFrameTroca = agora;
                    frameIE++;
                    if (frameIE > 3) frameIE = 0;
                }
                f = (SDL_Rect){ 322 * frameIE, 588, 322, 294 }; // linha 3
            }
    }
    
    if (keys[SDL_SCANCODE_RIGHT]) {
        movendo = 1;
        if (frameAtual == esquerda && !virando) { virando = 2; frameVirada = 0; ultimoFrameTroca = agora; }
        player.x += 10;
        if (virando == 2) {
            if (agora - ultimoFrameTroca > intervaloFrame) {
                ultimoFrameTroca = agora;
                frameVirada++;
                if (frameVirada > 2) { virando = 0; frameID = 0; frameAtual = direita; }
            }
            f = (SDL_Rect){ 322 * frameVirada, 882, 322, 294 }; // linha 4
            } else {
                frameAtual = direita;
                if (agora - ultimoFrameTroca > intervaloFrame) {
                    ultimoFrameTroca = agora;
                    frameID++;
                    if (frameID > 3) frameID = 0;
                }
            f = (SDL_Rect){ 322 * frameID, 0, 322, 294 }; // linha 1
            }
    }
    
    if (!movendo && !virando){
    	if(frameAtual == direita) f = (SDL_Rect){0,0,322,294};
    	else if(frameAtual == esquerda) f = (SDL_Rect){0,588,322,294};
	}

    // GRAVIDADE
    player.y += vely;
    vely += gravidade;
    noChao = 0; // assume que está no ar até confirmar

    // COLISÃO COM O CHÃO
    int chao = altura - 150;
    if (player.y >= chao) {
        player.y = chao;
        vely = 0;
        noChao = 1;
    }

    // COLISÃO COM PLATAFORMAS (POR CIMA)
    for (int i=0; i<numPlataformas; i++) {
        SDL_Rect plat = plataformas[i];
        if (vely >= 0 &&
            player.y + player.h > plat.y &&
            player.y + player.h - vely <= plat.y &&
            player.x + player.w > plat.x &&
            player.x < plat.x + plat.w) 
        {
            player.y = plat.y - player.h;
            vely = 0;
            noChao = 1;
        }
    }

    // COLISÃO POR BAIXO (BATEU CABEÇA)
    for (int i=0; i<numPlataformas; i++) {
        SDL_Rect plat = plataformas[i];
        if (vely < 0 &&
            player.y <= plat.y + plat.h &&
            player.y - vely >= plat.y + plat.h &&
            player.x + player.w > plat.x &&
            player.x < plat.x + plat.w) 
        {
            player.y = plat.y + plat.h;
            vely = 0;
        }
    }
}
	SDL_DestroyTexture(parafr);
	SDL_DestroyTexture(parafu);
	SDL_DestroyTexture(lua);
	SDL_DestroyTexture(hud);
    SDL_DestroyTexture(fundo);
    SDL_DestroyTexture(sprites);
    SDL_DestroyRenderer(ren);
    SDL_DestroyWindow(win);
    SDL_Quit();
}
